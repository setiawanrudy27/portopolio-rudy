# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values locally.
# Never commit real credentials. `.env*` files are git-ignored (except this one).
# ---------------------------------------------------------------------------

# Neon PostgreSQL pooled connection string (used by the app at runtime).
DATABASE_URL=

# Neon PostgreSQL direct connection string (used by Prisma CLI for migrations).
# If your Neon project does not need a separate direct connection, leave empty.
DIRECT_URL=

# Auth.js (Phase 2)
AUTH_SECRET=
AUTH_URL=

# Admin provisioning (Phase 2) - isi secara lokal, jangan commit.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# S3-compatible object storage (Phase 5)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# FormSubmit.co recipient email (Phase 6)
FORMSUBMIT_EMAIL=

# Public site URL, no trailing slash. Safe to expose to the browser.
NEXT_PUBLIC_SITE_URL=
